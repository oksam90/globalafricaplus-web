APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Smile Identity — eKYC + AML
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_ENVIRONMENT=sandbox
SMILE_CALLBACK_URL=https://example.com/api/v1/webhooks/smile-identity
VITE_SMILE_PARTNER_ID="${SMILE_PARTNER_ID}"
VITE_SMILE_ENVIRONMENT="${SMILE_ENVIRONMENT}"

# Conventions — PDF (LibreOffice)
# Yousign : CONSERVÉ, réactivable via SIGNATURE_PROVIDER=yousign
CONVENTION_PDF=true
LIBREOFFICE_BIN=soffice
YOUSIGN_MODE=sandbox
YOUSIGN_API_KEY=
YOUSIGN_SIGNATURE_LEVEL=electronic_signature
YOUSIGN_AUTH_MODE=no_otp
YOUSIGN_WEBHOOK_SECRET=

# ─── Signature électronique — DocuSeal auto-hébergé (Yousign conservé) ───
SIGNATURE_PROVIDER=docuseal
CONVENTION_AUTO_SEND=true
# Production de la convention : "validation" (clic sur « Payer ») | "payment"
CONVENTION_GENERATE_ON=validation
# Envoi à la signature : "first_payment" (défaut) | "validation" | "full_payment"
# first_payment évite d'envoyer une convention au porteur pour un paiement
# abandonné au checkout, tout en signant dès la 1re échéance en fractionné.
CONVENTION_SEND_ON=first_payment

DOCUSEAL_URL=https://sign.globalafricaplus.com
DOCUSEAL_API_TOKEN=
# Mode d'envoi : "template" (édition libre) | "oneoff" (édition Pro)
DOCUSEAL_MODE=template
# Gabarits DocuSeal par type de convention (php artisan docuseal:templates)
DOCUSEAL_TEMPLATE_EQUITY=
DOCUSEAL_TEMPLATE_DONATION=
DOCUSEAL_TEMPLATE_LOAN=
DOCUSEAL_TEMPLATE_REWARD=

# Emails envoyés par DocuSeal : exige un SMTP configuré dans son interface.
# À false, les liens de signature sont affichés dans l'application.
DOCUSEAL_SEND_EMAIL=false
DOCUSEAL_ORDER=random
DOCUSEAL_EXPIRE_DAYS=30
# Secret HMAC du webhook — Webhooks → SÉCURITÉ → onglet HMAC.
# Copier la valeur COMPLÈTE, préfixe whsec_ inclus.
# OBLIGATOIRE : sans ce secret, les appels DocuSeal sont REFUSÉS (fermé par défaut).
DOCUSEAL_WEBHOOK_SECRET=
