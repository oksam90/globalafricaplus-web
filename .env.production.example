APP_NAME="GlobalAfrica+"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://globalafricaplus.com
APP_TIMEZONE=UTC
APP_LOCALE=fr

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=globalafricaplus
DB_USERNAME=gapuser
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@globalafricaplus.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@globalafricaplus.com
MAIL_FROM_NAME="GlobalAfrica+"

# IDNorm KYC (mode prod)
IDNORM_MODE=prod
IDNORM_BASE_URL=https://api.idnorm.com/v1
IDNORM_API_KEY=
IDNORM_API_SECRET=
IDNORM_WEBHOOK_SECRET=

# Sanctum / Session
SANCTUM_STATEFUL_DOMAINS=globalafricaplus.com,www.globalafricaplus.com
SESSION_DOMAIN=.globalafricaplus.com
SESSION_SECURE_COOKIE=true

# ─────────────────────────────────────────────────────────────────
# PSP actif — "pawapay" (défaut) ou "paydunya"
# ─────────────────────────────────────────────────────────────────
PAYMENT_GATEWAY=pawapay
PAYMENT_FALLBACK_GATEWAY=paydunya

# Deux moyens de paiement proposés à l'utilisateur :
#   mobile_money → PawaPay   |   card → PayDunya (Visa/Mastercard)
PAYMENT_DEFAULT_METHOD=mobile_money
PAYMENT_METHOD_MOBILE_MONEY=true
PAYMENT_METHOD_CARD=true

# PawaPay — Merchant API v2 (https://docs.pawapay.io/v2)
# Le token API se génère dans Dashboard → Developers → Create API Token,
# APRÈS avoir renseigné les 4 Callback URLs ci-dessous.
PAWAPAY_MODE=sandbox                 # sandbox | production
PAWAPAY_API_TOKEN=
PAWAPAY_CALLBACK_BASE=https://globalafricaplus.com
PAWAPAY_LANGUAGE=FR
PAWAPAY_STATEMENT="GlobalAfrica Plus"
PAWAPAY_SIGNED_CALLBACKS=false
# Callback URLs à recopier dans le Dashboard :
#   Checkouts : https://globalafricaplus.com/api/v1/webhooks/pawapay/checkouts
#   Deposits  : https://globalafricaplus.com/api/v1/webhooks/pawapay/deposits
#   Payouts   : https://globalafricaplus.com/api/v1/webhooks/pawapay/payouts
#   Refunds   : https://globalafricaplus.com/api/v1/webhooks/pawapay/refunds

# Barème de commission GlobalAfrica+ (montants pivots exprimés en EUR,
# jamais exposés publiquement — seul le barème 3 % / 2 % / 1 % l'est).
#   ≥      5 €  →  3,00 %
#   ≥  5 000 €  →  2,00 %
#   ≥ 20 000 €  →  1,00 %
COMMISSION_MIN_AMOUNT=5
COMMISSION_RATE_1=0.03
COMMISSION_PIVOT_2=5000
COMMISSION_RATE_2=0.02
COMMISSION_PIVOT_3=20000
COMMISSION_RATE_3=0.01

# PayDunya — ACTIF : prend en charge les paiements par CARTE BANCAIRE (3,50 %).
# Tranche de flux mensuel de la grille tarifaire (1 = 200 – 99 999 999 FCFA/mois)
PAYDUNYA_VOLUME_TIER=1
PAYDUNYA_MASTER_KEY=votre_master_key
PAYDUNYA_PRIVATE_KEY=votre_private_key
PAYDUNYA_PUBLIC_KEY=votre_public_key
PAYDUNYA_TOKEN=votre_token
PAYDUNYA_MODE=test
PAYDUNYA_STORE_NAME=Globalafrica+
PAYDUNYA_WEBSITE=https://globalafricaplus.com
PAYDUNYA_CALLBACK_URL=https://globalafricaplus.com/api/v1/webhooks/paydunya
PAYDUNYA_RETURN_URL=https://globalafricaplus.com/paiement/succes
PAYDUNYA_CANCEL_URL=https://globalafricaplus.com/paiement/annule

# Smile Identity — eKYC + AML
SMILE_PARTNER_ID=votre_partner_id
SMILE_API_KEY=votre_api_key_sandbox
SMILE_ENVIRONMENT=sandbox
SMILE_CALLBACK_URL=https://globalafricaplus.com/api/v1/webhooks/smile-identity
VITE_SMILE_PARTNER_ID="${SMILE_PARTNER_ID}"
VITE_SMILE_ENVIRONMENT="${SMILE_ENVIRONMENT}"


# Conventions — PDF (LibreOffice) + signature (Yousign)
CONVENTION_PDF=true
LIBREOFFICE_BIN=soffice
YOUSIGN_MODE=production
YOUSIGN_API_KEY=votre_cle_api_yousign
YOUSIGN_SIGNATURE_LEVEL=electronic_signature
YOUSIGN_AUTH_MODE=otp_email
CONVENTION_AUTO_SEND=true
YOUSIGN_WEBHOOK_SECRET=votre_secret_webhook
